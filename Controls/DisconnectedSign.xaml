<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WkcCommunicator.Controls.DisconnectedSign"
			 xmlns:res="clr-namespace:WkcCommunicator.Resources">
    <VerticalStackLayout Spacing="30">
		<Image Source="{AppThemeBinding Light=bluetooth_disabled.png, Dark=bluetooth_disabled_dark.png}" Opacity="0.33" HeightRequest="120"/>
		<Label Opacity="0.5" Text="{x:Static res:AppResources.DisconnectedSign_NoDeviceConnected}" HorizontalOptions="Center" FontSize="Medium"/>
	</VerticalStackLayout>
</ContentView>
