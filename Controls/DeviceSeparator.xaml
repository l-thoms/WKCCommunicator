<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WkcCommunicator.Controls.DeviceSeparator"
			 x:Name="DeviceSeparatorView">
	<VerticalStackLayout Margin="20, 0">
		<HorizontalStackLayout>
			<Label WidthRequest="4"/>
			<Label Text="{Binding Source={Reference DeviceSeparatorView}, Path=Text}" Style="{StaticResource LabelLighter}" HeightRequest="30" VerticalTextAlignment="Center"/>
			<Label WidthRequest="4"/>
			<Image Source="{AppThemeBinding Light=keyboard_arrow_down.png, Dark=keyboard_arrow_down_dark.png}" Opacity="0.6" HeightRequest="16"/>
		</HorizontalStackLayout>
		<BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"/>
	</VerticalStackLayout>
</ContentView>
