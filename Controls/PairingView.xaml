<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WkcCommunicator.Controls.PairingView"
			 xmlns:controls="clr-namespace:WkcCommunicator.Controls" Loaded="ContentView_Loaded"
			 xmlns:res="clr-namespace:WkcCommunicator.Resources">
	<Grid Padding="24,24,24,0" Background="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
		<VerticalStackLayout VerticalOptions="Center" Spacing="6">
			<Label HorizontalOptions="Center" Text="{x:Static res:AppResources.PairingView_InputPassKey}" Style="{StaticResource LabelLighter}" FontSize="Medium"/>
			<HorizontalStackLayout HorizontalOptions="Center">
				<Entry x:Name="KeyEntry" MaxLength="6" IsPassword="True"  HorizontalTextAlignment="Center" Keyboard="Numeric" FontSize="Title" CharacterSpacing="12"
				TextChanged="Entry_TextChanged" WidthRequest="240"/>
			</HorizontalStackLayout>
			<controls:UnaccentedButton Text="{x:Static res:AppResources.PairingView_Cancel}" Padding="0, 0" Margin="0,20" HorizontalOptions="Center" WidthRequest="96" Clicked="UnaccentedButton_Clicked"/>
		</VerticalStackLayout>
    </Grid>
</ContentView>