<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WkcCommunicator.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WkcCommunicator"
    xmlns:res="clr-namespace:WkcCommunicator.Resources"
    Title="WKC Communicator">
	<TabBar>
		<ShellContent
            Title="{x:Static res:AppResources.AppShell_Discovery}"
            Icon="search.png"
            ContentTemplate="{DataTemplate local:MainPage}" />
		<ShellContent 
            Title="{x:Static res:AppResources.AppShell_MyDevice}"
            Icon="star.png"
            ContentTemplate="{DataTemplate local:MyDevicePage}"/>
		<ShellContent 
            Title="{x:Static res:AppResources.AppShell_DeviceSettings}"
            Icon="settings.png"
            ContentTemplate="{DataTemplate local:DeviceSettingsPage}"/>
	</TabBar>

</Shell>
