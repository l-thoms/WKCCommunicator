<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WkcCommunicator.MainPage"
             xmlns:controls="clr-namespace:WkcCommunicator.Controls" Loaded="ContentPage_Loaded"
			 xmlns:res="clr-namespace:WkcCommunicator.Resources">
             
    <RefreshView Refreshing="RefreshView_Refreshing" x:Name="MainRefreshView">
		<ScrollView>
        <VerticalStackLayout
            Padding="0,0"
            Spacing="12">
				<controls:DeviceSeparator Text="{x:Static res:AppResources.MainPage_MyDevice}"/>
				<VerticalStackLayout x:Name="MyDeviceLayout"/>
				<controls:DeviceSeparator Text="{x:Static res:AppResources.MainPage_NearbyDevice}"/>
				<VerticalStackLayout x:Name="NearbyDeviceLayout"/>
			</VerticalStackLayout>
		</ScrollView>
	</RefreshView>

</ContentPage>
